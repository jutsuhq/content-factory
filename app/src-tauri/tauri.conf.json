{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Content Factory",
  "version": "0.1.0",
  "identifier": "studio.jutsu.contentfactory",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Content Factory",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../../engine/pyproject.toml": "repo/engine/pyproject.toml",
      "../../engine/uv.lock": "repo/engine/uv.lock",
      "../../engine/README.md": "repo/engine/README.md",
      "../../engine/src/factory/": "repo/engine/src/factory/",
      "../../formats/": "repo/formats/",
      "../../render/package.json": "repo/render/package.json",
      "../../render/package-lock.json": "repo/render/package-lock.json",
      "../../render/tsconfig.json": "repo/render/tsconfig.json",
      "../../render/remotion.config.ts": "repo/render/remotion.config.ts",
      "../../render/src/": "repo/render/src/"
    },
    "category": "Video",
    "shortDescription": "Open-source AI faceless video generator",
      "longDescription": "Make faceless short videos for TikTok, YouTube Shorts and Instagram Reels on your own Mac: AI frames, motion, voiceover, subtitles and music.",
    "copyright": "MIT License"
  }
}
