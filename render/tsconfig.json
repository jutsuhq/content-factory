{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "*": ["./node_modules/@types/*", "./node_modules/*"] },
    "types": ["node"],
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src", "remotion.config.ts", "../formats/*/template"]
}
